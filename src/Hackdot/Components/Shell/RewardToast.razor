@using Hackdot.Core.Services.Missions
@implements IDisposable
@inject GameService Game
@inject ShellService Shell

@* Notices – new rank, technique card, achievement, mail – one at a time, gone after a few seconds. *@
@if (_current is { } notice)
{
    <div class="reward-toast @(notice.Kind == NoticeKind.Mail ? "mail" : null)" role="status" aria-live="polite"
         @key="notice" @onclick="() => Tap(notice)">
        <span class="icon" aria-hidden="true">
            @switch (notice.Kind)
            {
                case NoticeKind.Rank:
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="m6 13 6-6 6 6" /><path d="m6 19 6-6 6 6" /></svg>
                    break;
                case NoticeKind.Card:
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5" /><path d="M9 8h6M9 12h6M9 16h3" /></svg>
                    break;
                case NoticeKind.Mail:
                    <AppIcon App="AppId.Mail" Size="22" />
                    break;
                default:
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" /><path d="M17 5h3a3 3 0 0 1-3 4M7 5H4a3 3 0 0 0 3 4" /></svg>
                    break;
            }
        </span>
        <span class="text">
            <span class="label">@notice.Label</span>
            <strong>@notice.Title</strong>
        </span>
    </div>
}

@code {
    private enum NoticeKind
    {
        Achievement,
        Rank,
        Card,
        Mail,
    }

    private sealed record Notice(NoticeKind Kind, string Label, string Title);

    private static readonly TimeSpan ShowFor = TimeSpan.FromSeconds(4);

    /// <summary>Shorter when more notices are waiting, so a burst after a mission doesn't drag on.</summary>
    private static readonly TimeSpan ShowForInQueue = TimeSpan.FromSeconds(2.5);

    private readonly Queue<Notice> _queue = new();
    private Notice? _current;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        Game.Rewarded += OnRewarded;
        Game.MailArrived += OnMailArrived;
    }

    private void OnRewarded(Rewards rewards) => InvokeAsync(() =>
    {
        if (rewards.NewRank is { } rank)
        {
            _queue.Enqueue(new Notice(NoticeKind.Rank, L["Reward.Rank"], L[$"Rank.{rank.Id}"]));
        }

        foreach (var card in rewards.Cards)
        {
            _queue.Enqueue(new Notice(NoticeKind.Card, L["Reward.Card"], card.Title.Get()));
        }

        foreach (var achievement in rewards.Achievements)
        {
            var title = achievement.Chapter is { } chapter
                ? L["Achievement.Chapter.Title", chapter]
                : L[$"Achievement.{achievement.Id}.Title"];
            _queue.Enqueue(new Notice(NoticeKind.Achievement, L["Reward.Achievement"], title));
        }

        ShowNextIfIdle();
    });

    private void OnMailArrived(IReadOnlyList<MailMessage> messages) => InvokeAsync(() =>
    {
        // Oldest first, so the next job is the last thing the player sees.
        foreach (var message in messages.OrderBy(message => message.Order))
        {
            _queue.Enqueue(new Notice(NoticeKind.Mail, L["Reward.Mail", message.Mail.From], message.Mail.Subject.Get()));
        }

        ShowNextIfIdle();
    });

    private void ShowNextIfIdle()
    {
        if (_current is null)
        {
            Next();
        }
    }

    /// <summary>Tapping a mail notice opens the Mail app; any notice is dismissed.</summary>
    private void Tap(Notice notice)
    {
        if (notice.Kind == NoticeKind.Mail)
        {
            Shell.Open(AppId.Mail);
        }

        Next();
    }

    private void Next()
    {
        _timer?.Dispose();
        _current = _queue.TryDequeue(out var next) ? next : null;

        if (_current is not null)
        {
            _timer = new Timer(_ => InvokeAsync(Next), null, _queue.Count > 0 ? ShowForInQueue : ShowFor, Timeout.InfiniteTimeSpan);
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        Game.Rewarded -= OnRewarded;
        Game.MailArrived -= OnMailArrived;
        _timer?.Dispose();
    }
}
