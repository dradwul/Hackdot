@* Ordmärke: "hack." (kort) eller "hackdot" (lång). Stilarna ligger globalt i app.css
   eftersom samma logga även används i laddningsskärmen i index.html. *@
<span class="logo @Class" role="img" aria-label="Hackdot">@if (Full)
    {<span aria-hidden="true">hack<span class="logo-dot">dot</span></span>}
    else
    {<span aria-hidden="true">hack<span class="logo-dot">.</span></span>}</span>

@code {
    /// <summary>Visa "hackdot" i stället för "hack.".</summary>
    [Parameter] public bool Full { get; set; }

    [Parameter] public string? Class { get; set; }
}
