@implements IDisposable
@inject ShellService Shell
@inject GameService Game
@inject InstallService Install

<div class="os">
    <main class="workspace">
        <div class="wallpaper" aria-hidden="true">
            <Logo Class="wallpaper-logo" />
        </div>

        <ul class="desktop-icons" aria-label="@L["Shell.Apps"]">
            @foreach (var app in Shell.Apps)
            {
                <li>
                    <button type="button" class="desktop-icon" style="--app-accent: @app.Accent"
                            @onclick="() => Shell.Open(app.Id)">
                        <span class="icon-tile"><AppIcon App="app.Id" Size="30" /></span>
                        <span class="icon-label">@L[app.TitleKey]</span>
                    </button>
                </li>
            }
        </ul>

        @* Kept apart from the app icons: it installs the game itself, it isn't an app inside DotOS. *@
        @if (Install.CanInstall)
        {
            <button type="button" class="install-button" @onclick="Install.InstallAsync">
                <InstallIcon Size="18" />
                <span>@L["Install.Title"]</span>
            </button>
        }

        @* Every open app is rendered but only the active one is visible, so minimized
           apps keep their state (e.g. terminal history). *@
        @foreach (var id in Shell.OpenApps)
        {
            <AppWindow @key="id" App="Shell.Get(id)" Active="Shell.ActiveApp == id">
                @switch (id)
                {
                    case AppId.Mission: <MissionApp /> break;
                    case AppId.Terminal: <TerminalApp /> break;
                    case AppId.Files: <FilesApp /> break;
                    case AppId.Guide: <GuideApp /> break;
                }
            </AppWindow>
        }
    </main>

    <Dock />
</div>

@if (Game.IsLocked)
{
    <LoginScreen />
}

@if (Install.IsHelpOpen)
{
    <InstallHelp />
}

<UpdateBanner />

@code {
    protected override void OnInitialized()
    {
        Shell.Changed += OnShellChanged;
        Game.Changed += OnShellChanged;
        Install.Changed += OnShellChanged;

        // New players land straight in their first mission briefing.
        if (Game.IsFirstLaunch && Shell.OpenApps.Count == 0)
        {
            Shell.Open(AppId.Mission);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Install.InitializeAsync();
        }
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Shell.Changed -= OnShellChanged;
        Game.Changed -= OnShellChanged;
        Install.Changed -= OnShellChanged;
    }
}
