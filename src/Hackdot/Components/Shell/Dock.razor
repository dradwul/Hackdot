@implements IDisposable
@inject ShellService Shell
@inject GameService Game
@inject InstallService Install

<nav class="dock" aria-label="@L["Shell.Taskbar"]">
    <button type="button" class="start @(_menuOpen ? "open" : null)" aria-expanded="@Aria(_menuOpen)"
            aria-haspopup="menu" title="@L["Shell.Start"]" @onclick="ToggleMenu">
        <Logo />
    </button>

    <div class="tasks">
        @foreach (var id in Shell.OpenApps)
        {
            var app = Shell.Get(id);
            <button type="button" class="task @(Shell.ActiveApp == id ? "active" : null)"
                    style="--app-accent: @app.Accent" title="@L[app.TitleKey]" aria-pressed="@Aria(Shell.ActiveApp == id)"
                    @onclick="() => Shell.ToggleFromDock(id)">
                <AppIcon App="id" Size="20" />
                <span class="task-label">@L[app.TitleKey]</span>
            </button>
        }
    </div>

    <time class="clock" datetime="@_now.ToString("HH:mm")">@_now.ToString("HH:mm")</time>
</nav>

@if (_menuOpen)
{
    <div class="scrim" @onclick="CloseMenu"></div>
    <div class="start-menu" role="menu">
        <div class="menu-header">
            <Logo Animated="true" Class="menu-logo" />
            <span class="menu-subtitle">@L["Shell.LoggedInAs", Game.CurrentUser.Name, Game.FileSystem.Hostname]</span>
        </div>
        <ul>
            @foreach (var app in Shell.Apps)
            {
                <li>
                    <button type="button" role="menuitem" class="menu-item" style="--app-accent: @app.Accent"
                            @onclick="() => OpenFromMenu(app.Id)">
                        <span class="menu-icon"><AppIcon App="app.Id" Size="20" /></span>
                        <span class="menu-text">
                            <span class="menu-title">@L[app.TitleKey]</span>
                            <span class="menu-description">@L[app.DescriptionKey]</span>
                        </span>
                    </button>
                </li>
            }
            @if (Install.CanInstall)
            {
                @* Set apart from the apps: it installs the game itself. *@
                <li class="separated">
                    <button type="button" role="menuitem" class="menu-item" style="--app-accent: var(--accent-2)"
                            @onclick="InstallFromMenu">
                        <span class="menu-icon"><InstallIcon Size="20" /></span>
                        <span class="menu-text">
                            <span class="menu-title">@L["Install.Title"]</span>
                            <span class="menu-description">@L["Install.Description"]</span>
                        </span>
                    </button>
                </li>
            }
        </ul>
        <div class="menu-footer">
            <button type="button" role="menuitem" class="footer-button" @onclick="ShowDesktop">@L["Shell.ShowDesktop"]</button>
            <button type="button" role="menuitem" class="footer-button logout" @onclick="LogOut">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><path d="m10 17-5-5 5-5" /><path d="M5 12h12" /></svg>
                @L["Shell.LogOut"]
            </button>
        </div>
        @* Deliberately faint: useful when you look for it, never in the way. *@
        <a class="version" href="@AppVersion.ChangelogUrl" target="_blank" rel="noopener"
           title="@(AppVersion.Commit is { } commit ? L["Shell.Build", commit].Value : null)">
            @L["Shell.Version", AppVersion.Number] · @L["Shell.WhatsNew"]
        </a>
    </div>
}

@code {
    private bool _menuOpen;
    private DateTime _now = DateTime.Now;
    private Timer? _clock;

    protected override void OnInitialized()
    {
        Shell.Changed += OnShellChanged;
        _clock = new Timer(_ => InvokeAsync(() =>
        {
            _now = DateTime.Now;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(60 - DateTime.Now.Second), TimeSpan.FromMinutes(1));
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private void OpenFromMenu(AppId id)
    {
        _menuOpen = false;
        Shell.Open(id);
    }

    private async Task InstallFromMenu()
    {
        _menuOpen = false;
        await Install.InstallAsync();
    }

    private void ShowDesktop()
    {
        _menuOpen = false;
        Shell.ShowDesktop();
    }

    private void LogOut()
    {
        // Like a real OS: logging out closes every app.
        _menuOpen = false;
        Shell.CloseAll();
        Game.LogOut();
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Shell.Changed -= OnShellChanged;
        _clock?.Dispose();
    }
}
