@* Renders mission and guide text: blank lines separate paragraphs, `backticks` mark commands and paths,
   and **double asterisks** mark important words. *@
@foreach (var paragraph in Paragraphs)
{
    <p class="rich-text">@foreach (var segment in Segments(paragraph)){@switch (segment.Kind){case SegmentKind.Code:<code>@segment.Text</code>break;case SegmentKind.Bold:<strong>@segment.Text</strong>break;default:@segment.Text break;}}</p>
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    private enum SegmentKind
    {
        Text,
        Code,
        Bold,
    }

    private readonly record struct Segment(string Text, SegmentKind Kind);

    private IEnumerable<string> Paragraphs =>
        Text.Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static IEnumerable<Segment> Segments(string paragraph)
    {
        var codeParts = paragraph.Split('`');

        for (var i = 0; i < codeParts.Length; i++)
        {
            if (i % 2 == 1)
            {
                // Odd parts are between backticks: code is shown as-is, even if it contains asterisks.
                yield return new Segment(codeParts[i], SegmentKind.Code);
                continue;
            }

            var boldParts = codeParts[i].Split("**");

            for (var j = 0; j < boldParts.Length; j++)
            {
                if (boldParts[j].Length > 0)
                {
                    yield return new Segment(boldParts[j], j % 2 == 1 ? SegmentKind.Bold : SegmentKind.Text);
                }
            }
        }
    }
}
