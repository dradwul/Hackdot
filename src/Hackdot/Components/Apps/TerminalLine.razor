@using Hackdot.Core.Services.Terminal
@* Kept on one line on purpose: whitespace inside a pre-wrap line would be rendered. *@
<div class="line@(Line.IsError ? " error" : null)" style="@IndentStyle">@foreach (var segment in Line.Segments){<span class="@StyleClass(segment.Style)">@segment.Text</span>}</div>

@code {
    [Parameter, EditorRequired] public OutputLine Line { get; set; } = default!;

    private OutputLine? _renderedLine;

    // Output lines never change, so only re-render when we get a different line. Without this, every
    // keystroke in the terminal would re-render the whole scrollback (thousands of lines after a big 'cat').
    protected override bool ShouldRender() => !ReferenceEquals(_renderedLine, Line);

    protected override void OnAfterRender(bool firstRender) => _renderedLine = Line;

    // In a monospace font, 1ch is exactly one character column.
    private string? IndentStyle => Line.HangingIndent > 0
        ? $"padding-left: {Line.HangingIndent}ch; text-indent: -{Line.HangingIndent}ch"
        : null;

    private static string? StyleClass(OutputStyle style) => style switch
    {
        OutputStyle.Default => null,
        OutputStyle.Muted => "s-muted",
        OutputStyle.Accent => "s-accent",
        OutputStyle.Directory => "s-directory",
        OutputStyle.Success => "s-success",
        OutputStyle.Warning => "s-warning",
        OutputStyle.Error => "s-error",
        OutputStyle.Highlight => "s-highlight",
        _ => null,
    };
}
