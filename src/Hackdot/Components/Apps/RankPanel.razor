@using Hackdot.Core.Services.Missions
@inject GameService Game

@* The player's rank, the way to the next one, and every achievement. *@
<section class="rank-panel">
    <div class="rank-card">
        <span class="rank-label">@L["Rank.Current"]</span>
        <h2 class="rank-title">@L[$"Rank.{Rank.Id}"]</h2>
        <span class="rank-score">@L["Rank.Score", Score]</span>

        @if (Ranks.Next(Score) is { } next)
        {
            <div class="progress" role="progressbar" aria-valuemin="@Rank.MinimumScore" aria-valuemax="@next.MinimumScore"
                 aria-valuenow="@Score" aria-label="@L["Rank.Next", next.MinimumScore - Score, L[$"Rank.{next.Id}"]]">
                <span style="width: @(ProgressPercent(next).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </div>
            <span class="rank-next">@L["Rank.Next", next.MinimumScore - Score, L[$"Rank.{next.Id}"]]</span>
        }
        else
        {
            <span class="rank-next">@L["Rank.Top"]</span>
        }
    </div>

    <div class="achievements-header">
        <h3>@L["Achievements.Title"]</h3>
        <span class="count">@L["Achievements.Count", Tracker.Unlocked.Count, Tracker.All.Count]</span>
    </div>

    <ul class="achievements">
        @foreach (var achievement in Tracker.All)
        {
            var unlocked = Tracker.IsUnlocked(achievement);
            var hidden = achievement.Secret && !unlocked;
            <li class="achievement @(unlocked ? "unlocked" : null)">
                <span class="badge" aria-hidden="true">
                    @if (unlocked)
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" /><path d="M17 5h3a3 3 0 0 1-3 4M7 5H4a3 3 0 0 0 3 4" /></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                    }
                </span>
                <span class="text">
                    <span class="title">@(hidden ? L["Achievements.Secret"].Value : Title(achievement))</span>
                    <span class="description">@(hidden ? L["Achievements.SecretDescription"].Value : Description(achievement))</span>
                </span>
                <span class="visually-hidden">@(unlocked ? L["Achievements.Unlocked"] : L["Achievements.Locked"])</span>
            </li>
        }
    </ul>
</section>

@code {
    private GameState State => Game.State;

    private AchievementTracker Tracker => State.Achievements;

    private int Score => State.TotalScore;

    private Rank Rank => State.Rank;

    private double ProgressPercent(Rank next) =>
        Math.Clamp(100.0 * (Score - Rank.MinimumScore) / (next.MinimumScore - Rank.MinimumScore), 0, 100);

    private string Title(Achievement achievement) => achievement.Chapter is { } chapter
        ? L["Achievement.Chapter.Title", chapter]
        : L[$"Achievement.{achievement.Id}.Title"];

    private string Description(Achievement achievement) => achievement.Chapter is { } chapter
        ? L["Achievement.Chapter.Description", chapter]
        : L[$"Achievement.{achievement.Id}.Description"];
}
