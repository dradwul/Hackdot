@using Hackdot.Core.Services.Terminal
@implements IDisposable
@inject TerminalService Terminal

<div class="terminal">
    @* column-reverse keeps the view pinned to the newest output without any JavaScript. *@
    <div class="scrollback" role="log" aria-live="polite" aria-label="@L["Terminal.Output"]">
        <div class="lines">
            @foreach (var line in Terminal.Lines)
            {
                <TerminalLine @key="line" Line="line" />
            }
        </div>
    </div>

    @if (_options.Count > 0)
    {
        @* Shown when Tab finds more than one name: tapping one finishes the word. *@
        <div class="suggestions" role="toolbar" aria-label="@L["Terminal.Suggestions"]">
            @foreach (var option in _options)
            {
                <button type="button" class="chip chip-option @(option.Label.EndsWith('/') ? "folder" : null)"
                        @onclick="() => UseOptionAsync(option)">@option.Label</button>
            }
        </div>
    }

    <div class="shortcuts" role="toolbar" aria-label="@L["Terminal.Shortcuts"]">
        <button type="button" class="chip chip-tab" title="@L["Terminal.Complete"]" aria-label="@L["Terminal.Complete"]"
                disabled="@(Terminal.PendingInputLabel is not null)" @onclick="CompleteAsync">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h14M12 6l6 6-6 6M21 5v14" /></svg>
            <span>Tab</span>
        </button>
        <button type="button" class="chip chip-icon" title="@L["Terminal.PreviousCommand"]"
                aria-label="@L["Terminal.PreviousCommand"]" disabled="@(Terminal.History.Count == 0)"
                @onclick="RecallPrevious">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
        </button>
        <button type="button" class="chip chip-icon" title="@L["Terminal.NextCommand"]"
                aria-label="@L["Terminal.NextCommand"]" disabled="@(_historyIndex < 0)"
                @onclick="RecallNext">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
        </button>
        @foreach (var shortcut in Shortcuts)
        {
            <button type="button" class="chip @(shortcut.RunsImmediately ? null : "chip-insert")"
                    @onclick="() => UseShortcutAsync(shortcut)">@shortcut.Command.Trim()@(shortcut.RunsImmediately || shortcut.Appends ? null : "…")</button>
        }
    </div>

    @* Tab completes instead of moving focus away from the input (Blazor can't cancel only some keys). *@
    <form class="input-row" @onsubmit="SubmitAsync" onkeydown="if (event.key === 'Tab' && !event.shiftKey) event.preventDefault()">
        <label class="prompt" for="terminal-input">
            @if (Terminal.PendingInputLabel is { } question)
            {
                <span class="prompt-question">@question</span>
            }
            else
            {
                <span class="prompt-path">&lrm;@Terminal.DisplayDirectory&lrm;</span><span class="prompt-sign">@(Terminal.IsRoot ? "#" : "$")</span>
            }
        </label>
        @* While su asks for a password the field is a password field: hidden, and never saved in history. *@
        <input id="terminal-input" @ref="_input" @bind="_command" @bind:event="oninput" @bind:after="ClearOptions" @onkeydown="OnKeyDown"
               type="@(Terminal.IsSecretInput ? "password" : "text")" autocomplete="off" autocapitalize="off" autocorrect="off"
               spellcheck="false" enterkeyhint="send" data-lpignore="true"
               placeholder="@(Terminal.IsSecretInput ? L["Terminal.PasswordPlaceholder"] : L["Terminal.InputPlaceholder"])"
               aria-label="@(Terminal.PendingInputLabel ?? L["Terminal.Input"])" />
        <button type="submit" class="run" title="@L["Terminal.Run"]" aria-label="@L["Terminal.Run"]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 10l-5 5 5 5" /><path d="M20 4v7a4 4 0 0 1-4 4H4" /></svg>
        </button>
    </form>
</div>

@code {
    /// <param name="RunsImmediately">Complete commands run on tap; the others are typed into the input.</param>
    /// <param name="Appends">Added to the end of what is already typed (the pipe) instead of replacing it.</param>
    private sealed record Shortcut(string Command, bool RunsImmediately, bool Appends = false);

    private static readonly Shortcut[] Shortcuts =
    [
        new("ls -la", true),
        new("cd ..", true),
        new("cat ", false),
        new("grep ", false),
        // '|' is buried deep in most phone keyboards.
        new(" | ", false, Appends: true),
        new("find ", false),
        new("cd ", false),
        new("pwd", true),
        new("help", true),
        new("clear", true),
    ];

    private ElementReference _input;
    private string _command = "";
    private int _historyIndex = -1;
    private IReadOnlyList<CompletionOption> _options = [];

    protected override void OnInitialized() => Terminal.Changed += OnTerminalChanged;

    private async Task SubmitAsync()
    {
        Run(_command);
        _command = "";
        await _input.FocusAsync();
    }

    private void Run(string command)
    {
        _options = [];
        _historyIndex = -1;
        Terminal.Submit(command);
    }

    private async Task UseShortcutAsync(Shortcut shortcut)
    {
        if (shortcut.RunsImmediately)
        {
            Run(shortcut.Command);
            return;
        }

        _command = shortcut.Appends ? _command.TrimEnd() + shortcut.Command : shortcut.Command;
        _options = [];
        await _input.FocusAsync();
    }

    private void RecallPrevious()
    {
        // Never paste an old command into a password prompt.
        if (Terminal.History.Count == 0 || Terminal.PendingInputLabel is not null)
        {
            return;
        }

        _historyIndex = _historyIndex < 0 ? Terminal.History.Count - 1 : Math.Max(0, _historyIndex - 1);
        _command = Terminal.History[_historyIndex];
        _options = [];
    }

    private void RecallNext()
    {
        if (_historyIndex < 0)
        {
            return;
        }

        _options = [];
        _historyIndex++;

        if (_historyIndex >= Terminal.History.Count)
        {
            _historyIndex = -1;
            _command = "";
        }
        else
        {
            _command = Terminal.History[_historyIndex];
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowUp":
                RecallPrevious();
                break;
            case "ArrowDown":
                RecallNext();
                break;
            case "Tab" when !e.ShiftKey:
                Complete();
                break;
        }
    }

    private async Task CompleteAsync()
    {
        Complete();
        await _input.FocusAsync();
    }

    private void Complete()
    {
        // Never complete inside a password prompt.
        if (Terminal.PendingInputLabel is not null)
        {
            return;
        }

        var completion = Terminal.Complete(_command);
        _command = completion.Input;
        _options = completion.Options;
    }

    private async Task UseOptionAsync(CompletionOption option)
    {
        _command = option.Input;
        _options = [];
        await _input.FocusAsync();
    }

    private void ClearOptions() => _options = [];

    private void OnTerminalChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Terminal.Changed -= OnTerminalChanged;
}
